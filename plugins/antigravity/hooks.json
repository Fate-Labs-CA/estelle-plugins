{
  "estelle": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./runtime/cli.mjs hook antigravity SessionStart",
        "timeout": 20
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./runtime/cli.mjs hook antigravity PreInvocation",
        "timeout": 20
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./runtime/cli.mjs hook antigravity PreToolUse",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ./runtime/cli.mjs hook antigravity PostToolUse",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./runtime/cli.mjs hook antigravity Stop",
        "timeout": 20
      }
    ]
  }
}
