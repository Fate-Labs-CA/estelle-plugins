{
  "name": "@fatelabs/openclaw-estelle",
  "version": "0.0.27",
  "description": "Estelle MCP, memory and session hooks for coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "Fate Labs",
  "homepage": "https://github.com/Fate-Labs-CA/estelle-plugins/blob/main/docs/install/openclaw.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fate-Labs-CA/estelle-plugins.git",
    "directory": "plugins/openclaw-native"
  },
  "bugs": {
    "url": "https://github.com/Fate-Labs-CA/estelle-plugins/issues"
  },
  "engines": {
