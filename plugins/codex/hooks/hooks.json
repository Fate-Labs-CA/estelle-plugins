{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/cli.mjs\" hook codex",
            "timeout": 20,
            "statusMessage": "Estelle: SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/cli.mjs\" hook codex",
            "timeout": 20,
            "statusMessage": "Estelle: UserPromptSubmit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/cli.mjs\" hook codex",
            "timeout": 20,
            "statusMessage": "Estelle: PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/cli.mjs\" hook codex",
            "timeout": 20,
            "statusMessage": "Estelle: Stop"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/cli.mjs\" hook codex",
            "timeout": 20,
            "statusMessage": "Estelle: SubagentStart"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/cli.mjs\" hook codex",
            "timeout": 20,
            "statusMessage": "Estelle: SubagentStop"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/cli.mjs\" hook codex",
            "timeout": 20,
            "statusMessage": "Estelle: PreCompact"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/cli.mjs\" hook codex",
            "timeout": 3,
            "statusMessage": "Estelle: SessionEnd"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "(^|[.:])(Write|Edit|MultiEdit|NotebookEdit|apply_patch|write_file|replace)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/cli.mjs\" hook codex",
            "timeout": 20,
            "statusMessage": "Estelle: PreToolUse"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/cli.mjs\" hook codex",
            "timeout": 3,
            "statusMessage": "Estelle: Interrupt"
          }
        ]
      }
    ]
  }
}
